{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "ropedropplannerbot",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "http": {
      "enable": true,
      "domains": [
        "ropedrop-bot-data.storage.googleapis.com"
      ]
    },
    "redis": true,
    "reddit": {
      "enable": true,
      "scope": "moderator"
    }
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/app-install",
    "onAppUpgrade": "/internal/triggers/app-upgrade",
    "onPostCreate": "/internal/triggers/post-create",
    "onCommentCreate": "/internal/triggers/comment-create"
  },
  "menu": {
    "items": [
      {
        "label": "Ask RopeDrop bot",
        "description": "Ask the RopeDrop bot to answer this (ignores flair skip list and hourly cap; still needs confidence >= 0.5).",
        "location": [
          "post",
          "comment"
        ],
        "forUserType": "moderator",
        "endpoint": "/internal/menu/ask"
      }
    ]
  },
  "scheduler": {
    "tasks": {
      "daily-outlook": {
        "endpoint": "/internal/scheduler/daily-outlook",
        "cron": "0 * * * *"
      },
      "bundle-refresh": {
        "endpoint": "/internal/scheduler/bundle-refresh",
        "cron": "10 9-12 * * *"
      },
      "weekly-posts": {
        "endpoint": "/internal/scheduler/weekly-posts",
        "cron": "5 * * * *"
      }
    }
  },
  "settings": {
    "subreddit": {
      "dryRun": {
        "type": "boolean",
        "label": "Dry run (log instead of posting)",
        "helpText": "ON by default. While on, the bot only writes what it would post to the app logs. Turn off to go live.",
        "defaultValue": true
      },
      "minConfidence": {
        "type": "number",
        "label": "Minimum confidence to auto-reply (0.5-1)",
        "defaultValue": 0.7,
        "validationEndpoint": "/internal/settings/min-confidence"
      },
      "maxRepliesPerHour": {
        "type": "number",
        "label": "Max automatic replies per rolling hour",
        "defaultValue": 5,
        "validationEndpoint": "/internal/settings/max-replies"
      },
      "skipFlairs": {
        "type": "string",
        "label": "Skip posts with these flairs (comma-separated)",
        "defaultValue": "Trip Report, Photo, Photos, Meta"
      },
      "feedbackUrl": {
        "type": "string",
        "label": "Feedback link in the reply footer",
        "defaultValue": "https://www.reddit.com/message/compose?to=/r/ropedropplanner&subject=RopeDrop%20bot%20feedback",
        "validationEndpoint": "/internal/settings/https-url"
      },
      "dailyPostEnabled": {
        "type": "boolean",
        "label": "Post \"Today's Crowd Outlook\" daily",
        "defaultValue": true
      },
      "dailyPostHourET": {
        "type": "number",
        "label": "Daily post hour (0-23, US Eastern Time)",
        "defaultValue": 7,
        "validationEndpoint": "/internal/settings/hour-et"
      },
      "dailyDestination": {
        "type": "select",
        "label": "Daily post destination",
        "options": [
          {
            "label": "Walt Disney World",
            "value": "wdw"
          },
          {
            "label": "Disneyland Resort",
            "value": "dlr"
          }
        ],
        "defaultValue": "wdw"
      },
      "dailyPostSticky": {
        "type": "boolean",
        "label": "Distinguish + sticky the daily post",
        "defaultValue": false
      },
      "weeklyQuestionsEnabled": {
        "type": "boolean",
        "label": "Post \"What Disney planners are asking\" on Mondays",
        "helpText": "Most-asked planning topics in Disney subreddits (last 2 weeks) with the RopeDrop page that answers each. Built and fact-checked by RopeDrop; skipped on thin weeks.",
        "defaultValue": false
      },
      "weeklyChangesEnabled": {
        "type": "boolean",
        "label": "Post \"What changed this week\" on Fridays (WDW + Disneyland)",
        "helpText": "Rides back open, refurbishments starting, Multi Pass price moves. Skipped when nothing changed.",
        "defaultValue": false
      },
      "weeklyPostHourET": {
        "type": "number",
        "label": "Weekly post hour (0-23, US Eastern Time)",
        "defaultValue": 9,
        "validationEndpoint": "/internal/settings/hour-et"
      }
    }
  },
  "scripts": {
    "build": "npm run build",
    "dev": "node scripts/snapshot-bundle.mjs --if-missing && vite build --watch"
  },
  "dev": {
    "subreddit": "ropedropplannerbo_dev"
  }
}
