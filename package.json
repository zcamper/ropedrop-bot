{
  "private": true,
  "name": "ropedropbot",
  "version": "0.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "devvit playtest",
    "deploy": "npm test && devvit upload",
    "launch": "npm run deploy && devvit publish",
    "login": "devvit login",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "prettier": "prettier --write .",
    "test": "npm run test:types && npm run lint && npm run test:unit && npm run build && npm run check:config",
    "test:types": "tsc --build",
    "test:unit": "tsc --build && node --test \"dist/types/src/**/*.test.js\"",
    "check:config": "node scripts/check-devvit-json.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@devvit/start": "0.14.5",
    "@devvit/web": "0.14.5",
    "@hono/node-server": "^2.0.3",
    "devvit": "0.14.5",
    "hono": "4.13.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2"
  },
  "description": "RopeDrop Planner Reddit bot (Devvit Web app): answers park questions from wait-time data and posts a daily crowd outlook."
}